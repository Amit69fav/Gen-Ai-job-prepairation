# Example environment variables for Gen-Ai-job-prepairation
# Copy this file to .env and fill values before running the app

# Server
PORT=3000
NODE_ENV=development

# MongoDB connection
MONGO_URI=mongodb://localhost:27017/gen-ai

# JWT secret
JWT_SECRET=your_jwt_secret_here

# Optional: cookie domain (set only in production if you need a domain)
COOKIE_DOMAIN=  # e.g. .example.com

# Optional: allowlist for CORS origin (frontend URL). You can set one origin or leave empty to use the defaults in the app.
CORS_ORIGIN=http://localhost:5173
